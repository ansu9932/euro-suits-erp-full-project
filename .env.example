# Generate local credentials with setup-local.py. Never put real values here.
APP_ENV=local
APP_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
KYC_ENCRYPTION_KEY=
DEMO_SEED=false
OWNER_USERNAME=
OWNER_NAME=
OWNER_PASSWORD=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_HOST=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Microsoft 365 OAuth SMTP (SMTP.SendAsApp permission and mailbox authorization)
SMTP_AUTH_MODE=
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
# Used only by create-developer, never sent to the running API
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
