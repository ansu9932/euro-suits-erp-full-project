{
  "name": "euro-suits-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare npm run check && DEPLOY_TARGET=cloudflare vite build",
    "test:proxy": "node --test tests/edge-proxy.test.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@lucide/svelte": "^1.46.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "animejs": "4.5.0",
    "jsbarcode": "^3.12.1",
    "svelte": "5.57.0",
    "three": "^0.186.1",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.146.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
